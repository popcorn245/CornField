{
  "name": "@popcorn245/cornfield-components",
  "version": "0.1.0",
  "description": "cornfield's interface as web components (spec 0011): <corn-map> and what follows, thin StencilRS shells over the engine in cornfield. The same files are served by every cornfield server at /cornfield/components/.",
  "license": "MIT",
  "author": "popcorn245 (https://github.com/popcorn245)",
  "homepage": "https://github.com/popcorn245/CornField/blob/main/docs/embedding.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popcorn245/CornField.git",
    "directory": "components"
  },
  "bugs": {
    "url": "https://github.com/popcorn245/CornField/issues"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "topology",
    "cornfield",
    "stencil"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./corn-map": {
      "types": "./dist/types/corn-map.d.ts",
      "default": "./dist/corn-map.js"
    },
    "./corn-review": {
      "types": "./dist/types/corn-review.d.ts",
      "default": "./dist/corn-review.js"
    },
    "./corn-scope": {
      "types": "./dist/types/corn-scope.d.ts",
      "default": "./dist/corn-scope.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./version.json": "./dist/version.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "check:size": "node scripts/size-budget.mjs",
    "size:record": "node scripts/size-budget.mjs --record",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm test && npm run test:browser && npm run check:size",
    "prepublishOnly": "node scripts/release-guard.mjs"
  },
  "devDependencies": {
    "@popcorn245/stencilrs": "0.2.0",
    "@stencil/core": "5.0.0-beta.25",
    "@stencil/unplugin": "5.0.0-beta.25",
    "@vitest/browser-playwright": "5.0.4",
    "axe-core": "4.13.0",
    "happy-dom": "21.0.1",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
